# ==========================================
# CONFIGURAZIONE COMPILEFORGE - TEMPLATE
# ==========================================

# --- SERVER ---
PORT=8080
HOST=0.0.0.0

# --- SICUREZZA ---
# Chiave richiesta per inviare job via POST /compile
API_KEY=inserisci_una_chiave_segreta_qui
# Token richiesto per accedere a GET /metrics su Gateway e Worker
METRICS_TOKEN=inserisci_un_token_segreto_qui

# --- DATABASE (Postgres) ---
# Sintassi: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://utente:password@127.0.0.1:5432/compileforge

# --- CACHE (Redis) ---
REDIS_URL=redis://127.0.0.1:6379

# --- BROKER (RabbitMQ) ---
# Sintassi: amqp://USER:PASSWORD@HOST:PORT
RABBITMQ_URL=amqp://utente:password@127.0.0.1:5672